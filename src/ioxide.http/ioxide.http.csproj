<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ioxide.http</RootNamespace>

    <PackageId>ioxide.http</PackageId>
    <Version>0.2.4</Version>
    <Authors>MDA2AV</Authors>
    <Description>Ring-native HTTP/1.1 client for the ioxide io_uring runtime: connections open, send and receive on the reactor's own ring and resume inline - no thread pool, no System.Net.Http. Byte-level request/response surface, keep-alive pooling, chunked decoding. For REST calls and proxying from inside a handler.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://mda2av.github.io/ioxide/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MDA2AV/ioxide</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>io_uring;http;httpclient;rest;proxy;linux;ioxide</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../ioxide/ioxide.csproj" />
  </ItemGroup>

</Project>
