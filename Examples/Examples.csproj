<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/ioxide/ioxide.csproj" />
    <ProjectReference Include="../src/clients/ioxide.pg/ioxide.pg.csproj" />
    <ProjectReference Include="../src/clients/ioxide.redis/ioxide.redis.csproj" />
    <ProjectReference Include="../src/clients/ioxide.file/ioxide.file.csproj" />
    <ProjectReference Include="../src/serving/ioxide.tls/ioxide.tls.csproj" />
    <ProjectReference Include="../src/protocols/ioxide.ngtcp2/ioxide.ngtcp2.csproj" />
    <ProjectReference Include="../src/protocols/ioxide.nghttp3/ioxide.nghttp3.csproj" />
  </ItemGroup>

  <!-- Static-file fixtures (the HttpArena data/static set) served by the `file` example. -->
  <ItemGroup>
    <Content Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
