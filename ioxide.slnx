<Solution>
  <!-- The runtime core, first and unnested: everything below builds on it. -->
  <Project Path="src/ioxide/ioxide.csproj" />

  <!-- Protocol layers, native-bundled or pure C#. -->
  <Folder Name="/protocols/">
    <Project Path="src/protocols/ioxide.nghttp2/ioxide.nghttp2.csproj" />
    <Project Path="src/protocols/ioxide.nghttp3/ioxide.nghttp3.csproj" />
    <Project Path="src/protocols/ioxide.http2/ioxide.http2.csproj" />
    <Project Path="src/protocols/ioxide.http3/ioxide.http3.csproj" />
    <Project Path="src/protocols/ioxide.ngtcp2/ioxide.ngtcp2.csproj" />
  </Folder>

  <!-- Outbound: what an app calls out to. -->
  <Folder Name="/clients/">
    <Project Path="src/clients/ioxide.httpclient/ioxide.httpclient.csproj" />
    <Project Path="src/clients/ioxide.file/ioxide.file.csproj" />
    <Project Path="src/clients/ioxide.pg/ioxide.pg.csproj" />
    <Project Path="src/clients/ioxide.redis/ioxide.redis.csproj" />
  </Folder>

  <!-- Inbound: hosting integration. -->
  <Folder Name="/serving/">
    <Project Path="src/serving/ioxide.Kestrel/ioxide.Kestrel.csproj" />
  </Folder>

  <Folder Name="/apps/">
    <Project Path="Examples.AspNet/Examples.AspNet.csproj" />
  </Folder>

  <!-- One runnable project per workload, over a shared library. Each is run directly with
       "dotnet run" against its own project directory; see Playground/README.md.

       Grouped to match the folders on disk, so the IDE tree and the repository agree. -->
  <Folder Name="/apps/playground/">
    <Project Path="Playground/Shared/Playground.Shared.csproj" />
  </Folder>
  <Folder Name="/apps/playground/tcp/">
    <Project Path="Playground/Tcp/Raw/Playground.Tcp.Raw.csproj" />
    <Project Path="Playground/Tcp/Pipe/Playground.Tcp.Pipe.csproj" />
    <Project Path="Playground/Tcp/Hop/Playground.Tcp.Hop.csproj" />
    <Project Path="Playground/Tcp/TaskRun/Playground.Tcp.TaskRun.csproj" />
    <Project Path="Playground/Tcp/Incremental/Playground.Tcp.Incremental.csproj" />
    <Project Path="Playground/Tcp/Big/Playground.Tcp.Big.csproj" />
  </Folder>

  <Folder Name="/apps/playground/tls/">
    <Project Path="Playground/Tls/Ktls/Playground.Tls.Ktls.csproj" />
    <Project Path="Playground/Tls/Hybrid/Playground.Tls.Hybrid.csproj" />
    <Project Path="Playground/Tls/KtlsPipes/Playground.Tls.KtlsPipes.csproj" />
    <Project Path="Playground/Tls/MultiPort/Playground.Tls.MultiPort.csproj" />
    <Project Path="Playground/Tls/OpenSsl/Playground.Tls.OpenSsl.csproj" />
    <Project Path="Playground/Tls/OpenSslPipes/Playground.Tls.OpenSslPipes.csproj" />
    <Project Path="Playground/Tls/SslStream/Playground.Tls.SslStream.csproj" />
  </Folder>

  <Folder Name="/apps/playground/http2/">
    <Project Path="Playground/Http2/Nghttp2/Playground.Http2.Nghttp2.csproj" />
    <Project Path="Playground/Http2/Managed/Playground.Http2.Managed.csproj" />
    <Project Path="Playground/Http2/Tls/Playground.Http2.Tls.csproj" />
    <Project Path="Playground/Http2/SslStream/Playground.Http2.SslStream.csproj" />
  </Folder>

  <Folder Name="/apps/playground/http3/">
    <Project Path="Playground/Http3/Nghttp3/Playground.Http3.Nghttp3.csproj" />
    <Project Path="Playground/Http3/Buffered/Playground.Http3.Buffered.csproj" />
  </Folder>

  <Folder Name="/apps/playground/quic/">
    <Project Path="Playground/Quic/Alpn/Playground.Quic.Alpn.csproj" />
    <Project Path="Playground/Quic/Pipe/Playground.Quic.Pipe.csproj" />
    <Project Path="Playground/Quic/Raw/Playground.Quic.Raw.csproj" />
  </Folder>

  <Folder Name="/apps/playground/proxy/">
    <Project Path="Playground/Proxy/H1ToH1/Playground.Proxy.H1ToH1.csproj" />
    <Project Path="Playground/Proxy/H1ToH2/Playground.Proxy.H1ToH2.csproj" />
    <Project Path="Playground/Proxy/H1ToH3/Playground.Proxy.H1ToH3.csproj" />
    <Project Path="Playground/Proxy/H2ToH1/Playground.Proxy.H2ToH1.csproj" />
    <Project Path="Playground/Proxy/H2ToH2/Playground.Proxy.H2ToH2.csproj" />
    <Project Path="Playground/Proxy/H2ToH3/Playground.Proxy.H2ToH3.csproj" />
    <Project Path="Playground/Proxy/H3ToH1/Playground.Proxy.H3ToH1.csproj" />
    <Project Path="Playground/Proxy/H3ToH2/Playground.Proxy.H3ToH2.csproj" />
    <Project Path="Playground/Proxy/H3ToH3/Playground.Proxy.H3ToH3.csproj" />
  </Folder>

  <Folder Name="/apps/playground/clients/">
    <Project Path="Playground/Clients/Pg/Playground.Clients.Pg.csproj" />
    <Project Path="Playground/Clients/Redis/Playground.Clients.Redis.csproj" />
    <Project Path="Playground/Clients/File/Playground.Clients.File.csproj" />
    <Project Path="Playground/Clients/Https/Playground.Clients.Https.csproj" />
    <Project Path="Playground/Clients/Http/Playground.Clients.Http.csproj" />
    <Project Path="Playground/Clients/Quic/Playground.Clients.Quic.csproj" />
  </Folder>


  <!-- Research scratch - kept out of the main apps listing. -->
  <Folder Name="/apps/research/">
    <Project Path="Research/Examples/Examples.csproj" />
  </Folder>

  <Folder Name="/tests/">
    <Project Path="tests/Ioxide.Tests.Harness/Ioxide.Tests.Harness.csproj" />
    <Project Path="tests/Ioxide.Tests.Unit/Ioxide.Tests.Unit.csproj" />
    <Project Path="tests/Ioxide.Tests.E2E/Ioxide.Tests.E2E.csproj" />
    <Project Path="tests/Ioxide.Tests.Http/Ioxide.Tests.Http.csproj" />
    <Project Path="tests/Ioxide.Tests.Pg/Ioxide.Tests.Pg.csproj" />
    <Project Path="tests/Ioxide.Tests.Redis/Ioxide.Tests.Redis.csproj" />
    <Project Path="tests/Ioxide.Tests.Tls/Ioxide.Tests.Tls.csproj" />
    <Project Path="tests/Ioxide.Tests.File/Ioxide.Tests.File.csproj" />
    <Project Path="tests/Ioxide.Tests.Chaos/Ioxide.Tests.Chaos.csproj" />
  </Folder>

  <Folder Name="/bench/">
    <Project Path="bench/Bench.Clients/Bench.Clients.csproj" />
    <File Path="bench/run.sh" />
  </Folder>

  <!-- Not built by the solution; here so the native bundle scripts are findable from the IDE. -->
  <Folder Name="/build/">
    <File Path="scripts/build-ngtcp2-native.sh" />
    <File Path="scripts/build-nghttp2-native.sh" />
    <File Path="scripts/build-nghttp3-native.sh" />
  </Folder>
</Solution>
