<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end test runner (a plain console app, not a unit-test framework): it starts real ioxide
    reactors on background threads and drives them over real TCP sockets, so it exercises the core
    and every module exactly as a client would. It exits non-zero if any test fails. Sidecar-backed
    tests (pg, redis, kTLS) skip cleanly when the dependency isn't reachable, so the suite stays
    green on a bare machine instead of being brittle. Run it with "dotnet run" on this project, or
    via scripts/e2e.sh (which launches the pg + redis sidecars, then runs the suite and a load test).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
	  <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Ioxide.E2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/ioxide/ioxide.csproj" />
    <ProjectReference Include="../src/ioxide.ngtcp2/ioxide.ngtcp2.csproj" />
    <ProjectReference Include="../src/ioxide.nghttp3/ioxide.nghttp3.csproj" />
    <ProjectReference Include="../src/ioxide.http3/ioxide.http3.csproj" />
    <ProjectReference Include="../src/ioxide.http/ioxide.http.csproj" />
    <ProjectReference Include="../src/ioxide.httpclient/ioxide.httpclient.csproj" />
    <ProjectReference Include="../src/ioxide.nghttp2/ioxide.nghttp2.csproj" />
    <ProjectReference Include="../src/ioxide.pg/ioxide.pg.csproj" />
    <ProjectReference Include="../src/ioxide.redis/ioxide.redis.csproj" />
    <ProjectReference Include="../src/ioxide.tls/ioxide.tls.csproj" />
    <ProjectReference Include="../src/ioxide.file/ioxide.file.csproj" />
  </ItemGroup>

</Project>
